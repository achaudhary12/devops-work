[Unit]
Description=Jev desk: jev
After=network-online.target desk-recorder.service desk-guard.service
Wants=network-online.target desk-recorder.service desk-guard.service

[Service]
Type=simple
User=desk
WorkingDirectory=/opt/desk
Environment=DESK_HOME=/opt/desk/var
# shadow | paper | live  (jev also accepts shadow; the guard is not needed in shadow)
Environment=DESK_MODE=shadow
ExecStart=/opt/desk/.venv/bin/python -m desk.live --config desk.toml --mode ${DESK_MODE}
Restart=always
RestartSec=2
# a crashed process is restarted; the guard has already cancelled everything (deaths.md D6)

[Install]
WantedBy=multi-user.target
