[Unit]
Description=Jev desk: recorder
After=network-online.target 
Wants=network-online.target 

[Service]
Type=simple
User=desk
WorkingDirectory=/opt/desk
Environment=DESK_HOME=/opt/desk/var
# shadow | paper | live  (jev also accepts shadow; the guard is not needed in shadow)
Environment=DESK_MODE=shadow
ExecStart=/opt/desk/.venv/bin/python -m desk.recorder --config desk.toml
Restart=always
RestartSec=2
# a crashed process is restarted; the guard has already cancelled everything (deaths.md D6)

[Install]
WantedBy=multi-user.target
