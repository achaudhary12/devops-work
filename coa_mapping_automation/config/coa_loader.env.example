# -----------------------------------------------------------------------------
# COA mapping loader configuration.
# Copy to config/coa_loader.env and edit. Keep it chmod 600.
# -----------------------------------------------------------------------------

# Install location (directories below are created on first run)
COA_HOME=/opt/coa_mapping
INBOX_DIR=$COA_HOME/data/inbox        # Finance drops .xlsx / .csv here
WORK_DIR=$COA_HOME/data/work
ARCHIVE_DIR=$COA_HOME/data/archive    # processed OK
ERROR_DIR=$COA_HOME/data/error        # rejected files + <file>.errors.csv
LOG_DIR=$COA_HOME/logs

# Oracle client
export ORACLE_HOME=/u01/app/oracle/product/19.0.0/client_1
export TNS_ADMIN=$ORACLE_HOME/network/admin
export PATH=$ORACLE_HOME/bin:$PATH
export NLS_LANG=AMERICAN_AMERICA.AL32UTF8

# Connection. Preferred: a Secure External Password Store (wallet) entry, so no
# password lives on disk in clear text:  DB_CONNECT="/@COAMAP"
# Fallback (not recommended):           DB_CONNECT="coa_owner/secret@COAMAP"
DB_CONNECT="/@COAMAP"

PYTHON_BIN=python3

# Business switches passed to xx_coa_map_loader_pkg.process_batch
VALIDATE_TARGETS=Y     # COA targets must exist in MAPPING_SET_VALUES
OVERWRITE_BLANKS=N     # N = blank Excel cell keeps the existing DB value
CREATE_MAPPING_SETS=Y  # Y = new MAPPING_SET_NAME creates the master row

# A file must be untouched this many minutes before it is picked up, so a
# half-copied upload is never read.
FILE_MIN_AGE_MIN=1

# Notification (leave NOTIFY_TO empty to disable)
NOTIFY_TO="finance-gl-team@example.com"
MAIL_SUBJECT_PREFIX="[COA Mapping Load]"
# Flag your mailx uses to attach a file: "-a" (mailx/s-nail), "-A" (GNU
# mailutils). Leave empty to put the error lines in the body only.
MAIL_ATTACH_FLAG="-a"

LOG_RETENTION_DAYS=60
STAGING_RETENTION_DAYS=90
